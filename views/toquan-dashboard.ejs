<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Hộ Khẩu - BlueMoon</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --primary-color: #2a9d8f;
            --secondary-color: #264653;
            --light-color: #e9c46a;
            --accent-color: #f4a261;
            --dark-color: #e76f51;
            --sidebar-width: 250px;
            --border-radius: 12px;
            --card-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            --transition-speed: 0.3s;
        }
        
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fc;
            color: #333;
        }
        
        /* Enhanced Sidebar */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: linear-gradient(180deg, var(--secondary-color) 0%, #1d3a47 100%);
            position: fixed;
            left: 0;
            top: 0;
            color: white;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
            z-index: 100;
            transition: width var(--transition-speed);
        }
        
        .sidebar-header {
            padding: 25px;
            font-size: 28px;
            font-weight: bold;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.05);
            letter-spacing: 1px;
        }
        
        .sidebar-menu {
            padding: 25px 0;
            overflow-y: auto;
            max-height: calc(100vh - 180px);
        }
        
        .menu-item {
            padding: 16px 25px;
            cursor: pointer;
            transition: all var(--transition-speed);
            display: flex;
            align-items: center;
            font-size: 17px;
            text-decoration: none;
            color: rgba(255, 255, 255, 0.85);
            border-left: 3px solid transparent;
        }
        
        .menu-item:hover {
            background-color: rgba(42, 157, 143, 0.2);
            color: white;
            transform: translateX(3px);
        }
        
        .menu-item.active {
            background: linear-gradient(90deg, rgba(42, 157, 143, 0.2) 0%, rgba(42, 157, 143, 0) 100%);
            border-left: 3px solid var(--primary-color);
            color: white;
            font-weight: 500;
        }
        
        .menu-item i {
            margin-right: 15px;
            width: 24px;
            text-align: center;
            font-size: 18px;
            opacity: 0.9;
        }
        
        .logout-btn {
            position: absolute;
            bottom: 20px;
            width: 100%;
            padding: 16px 25px;
            cursor: pointer;
            transition: all var(--transition-speed);
            display: flex;
            align-items: center;
            font-size: 17px;
            color: rgba(255, 255, 255, 0.85);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .logout-btn:hover {
            background-color: rgba(231, 111, 81, 0.2);
            color: white;
        }
        
        .logout-btn i {
            margin-right: 15px;
            font-size: 18px;
        }
        
        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 25px;
            transition: margin var(--transition-speed);
        }
        
        .page-header {
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .page-title {
            font-size: 26px;
            font-weight: 600;
            color: var(--secondary-color);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
        }
        
        .page-title i {
            margin-right: 12px;
            font-size: 28px;
            color: var(--primary-color);
        }
        
        .page-subtitle {
            color: #6c757d;
            font-size: 15px;
            margin-bottom: 0;
        }
        
        /* Enhanced Stats Cards */
        .stats-row {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }
        
        .stat-card {
            flex: 1;
            min-width: 220px;
            background-color: white;
            border-radius: var(--border-radius);
            padding: 20px;
            box-shadow: var(--card-shadow);
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: transform 0.2s;
            position: relative;
            overflow: hidden;
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
        }
        
        .stat-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            background-color: var(--primary-color);
        }
        
        .stat-card-teal::after {
            background-color: var(--primary-color);
        }
        
        .stat-card-blue::after {
            background-color: var(--secondary-color);
        }
        
        .stat-card-yellow::after {
            background-color: var(--light-color);
        }
        
        .stat-card-orange::after {
            background-color: var(--accent-color);
        }
        
        .stat-info {
            position: relative;
            z-index: 2;
        }
        
        .stat-info h2 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 5px;
            color: #333;
        }
        
        .stat-info p {
            color: #6c757d;
            margin: 0;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .stat-icon {
            width: 65px;
            height: 65px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            border-radius: 50%;
            background: rgba(42, 157, 143, 0.1);
            color: var(--primary-color);
            position: relative;
            z-index: 2;
        }
        
        .stat-card-teal .stat-icon {
            background: rgba(42, 157, 143, 0.1);
            color: var(--primary-color);
        }
        
        .stat-card-blue .stat-icon {
            background: rgba(38, 70, 83, 0.1);
            color: var(--secondary-color);
        }
        
        .stat-card-yellow .stat-icon {
            background: rgba(233, 196, 106, 0.1);
            color: var(--light-color);
        }
        
        .stat-card-orange .stat-icon {
            background: rgba(244, 162, 97, 0.1);
            color: var(--accent-color);
        }
        
        /* Content Cards */
        .content-row {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .content-card {
            background-color: white;
            border-radius: var(--border-radius);
            box-shadow: var(--card-shadow);
            overflow: hidden;
            flex: 1;
            min-width: 0; /* Để flex-basis có thể co lại nhỏ hơn content */
        }
        
        .content-card-header {
            padding: 18px 20px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .content-card-title {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
            color: var(--secondary-color);
            display: flex;
            align-items: center;
        }
        
        .content-card-title i {
            margin-right: 10px;
            font-size: 16px;
            color: var(--primary-color);
        }
        
        .content-card-body {
            padding: 20px;
        }
        
        /* Data Tables */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }
        
        .custom-table {
            width: 100%;
            margin-bottom: 0;
        }
        
        .custom-table th {
            background-color: rgba(42, 157, 143, 0.05);
            color: var(--secondary-color);
            font-weight: 600;
            white-space: nowrap;
            padding: 12px 15px;
            font-size: 14px;
            border-bottom: 2px solid rgba(0, 0, 0, 0.05);
        }
        
        .custom-table td {
            padding: 12px 15px;
            vertical-align: middle;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            font-size: 14px;
        }
        
        .custom-table tbody tr:last-child td {
            border-bottom: none;
        }
        
        .custom-table tbody tr:hover {
            background-color: rgba(42, 157, 143, 0.03);
        }
        
        .table-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background-color: rgba(42, 157, 143, 0.1);
            color: var(--primary-color);
            margin-right: 8px;
        }
        
        /* Badge Styles */
        .status-badge {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            display: inline-block;
        }
        
        .badge-add {
            background-color: rgba(42, 157, 143, 0.1);
            color: var(--primary-color);
        }
        
        .badge-remove {
            background-color: rgba(231, 111, 81, 0.1);
            color: var(--dark-color);
        }
        
        .badge-move {
            background-color: rgba(244, 162, 97, 0.1);
            color: var(--accent-color);
        }
        
        .badge-temp {
            background-color: rgba(233, 196, 106, 0.1);
            color: var(--light-color);
        }
        
        /* Household Card */
        .household-table td {
            padding: 10px;
        }
        
        .household-table .household-header {
            background-color: rgba(38, 70, 83, 0.05);
            font-weight: 600;
        }
        
        .household-table .resident-row {
            background-color: rgba(42, 157, 143, 0.02);
        }
        
        .resident-info {
            display: flex;
            align-items: center;
        }
        
        .resident-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: rgba(42, 157, 143, 0.1);
            color: var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            font-size: 14px;
        }
        
        /* Empty State */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px;
            color: #6c757d;
        }
        
        .empty-state i {
            font-size: 48px;
            margin-bottom: 15px;
            color: rgba(42, 157, 143, 0.2);
        }
        
        .empty-state-text {
            font-size: 16px;
            text-align: center;
        }
        
        /* Action Button */
        .btn-action {
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 6px;
            padding: 8px 16px;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
        }
        
        .btn-action:hover {
            background-color: #248a7c;
            transform: translateY(-2px);
        }
        
        .btn-action i {
            margin-right: 6px;
        }
        
        .btn-secondary {
            background-color: #f8f9fa;
            color: #6c757d;
            border: 1px solid rgba(0, 0, 0, 0.1);
        }
        
        .btn-secondary:hover {
            background-color: #e9ecef;
        }
        
        /* Responsive Styles */
        @media (max-width: 1200px) {
            .content-row {
                flex-direction: column;
            }
        }
        
        @media (max-width: 992px) {
            .stats-row {
                flex-wrap: wrap;
            }
            
            .stat-card {
                flex: 1 0 45%;
                margin-bottom: 20px;
            }
        }
        
        @media (max-width: 768px) {
            .sidebar {
                width: 200px;
            }
            
            .main-content {
                margin-left: 200px;
            }
            
            .quick-action-btn {
                flex: 1 0 45%;
            }
        }
        
        @media (max-width: 576px) {
            .stat-card {
                flex: 1 0 100%;
            }
            
            .sidebar {
                width: 70px;
            }
            
            .sidebar-header {
                font-size: 18px;
                padding: 15px 0;
            }
            
            .menu-item span,
            .logout-btn span {
                display: none;
            }
            
            .menu-item i,
            .logout-btn i {
                margin-right: 0;
            }
            
            .main-content {
                margin-left: 70px;
                padding: 15px;
            }
            
            .quick-action-btn {
                flex: 1 0 100%;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            BLUEMOON
        </div>
        <div class="sidebar-menu">
            <a href="/toquan/hokhau-nhankhau" class="menu-item active">
                <i class="fas fa-tachometer-alt"></i>
                <span>Trang chủ</span>
            </a>
            <a href="/toquan/hokhau-nhankhau" class="menu-item">
                <i class="fas fa-house-user"></i>
                <span>Quản lý hộ khẩu</span>
            </a>
            <a href="/toquan/tamtrutamvang" class="menu-item">
                <i class="fas fa-exchange-alt"></i>
                <span>Tạm trú tạm vắng</span>
            </a>
            <a href="/toquan/thongke" class="menu-item">
                <i class="fas fa-chart-bar"></i>
                <span>Thống kê</span>
            </a>
            <a href="/toquan/maintenance" class="menu-item">
                <i class="fas fa-tools"></i>
                <span>Phân công bảo trì</span>
            </a>
            <a href="/toquan/vi-pham" class="menu-item">
                <i class="fas fa-exclamation-triangle"></i>
                <span>Quản lý vi phạm</span>
            </a>
            <a href="/toquan/bao-cao" class="menu-item">
                <i class="fas fa-file-alt"></i>
                <span>Tạo báo cáo</span>
            </a>
        </div>
        <div class="logout-btn">
            <a href="/logout" style="color: inherit; text-decoration: none; display: flex; align-items: center; width: 100%;">
                <i class="fas fa-sign-out-alt"></i>
                <span>ĐĂNG XUẤT</span>
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-tachometer-alt"></i>
                Trang Chủ Quản Lý
            </h1>
            <p class="page-subtitle">Tổng quan về thông tin hộ khẩu & nhân khẩu trong BlueMoon Apartment</p>
        </div>

        <!-- Stats Cards -->
        <div class="stats-row">
            <div class="stat-card stat-card-teal">
                <div class="stat-info">
                    <h2><%= totalHoKhau %></h2>
                    <p>Tổng số hộ khẩu</p>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-house-user"></i>
                </div>
            </div>
            <div class="stat-card stat-card-blue">
                <div class="stat-info">
                    <h2><%= totalNhanKhau %></h2>
                    <p>Tổng số nhân khẩu</p>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-users"></i>
                </div>
            </div>
            <div class="stat-card stat-card-yellow">
                <div class="stat-info">
                    <h2><%= totalTamTru %></h2>
                    <p>Tổng số tạm trú</p>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-sign-in-alt"></i>
                </div>
            </div>
            <div class="stat-card stat-card-orange">
                <div class="stat-info">
                    <h2><%= totalTamVang %></h2>
                    <p>Tổng số tạm vắng</p>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-sign-out-alt"></i>
                </div>
            </div>
        </div>

        <!-- Temporary Residence/Absence Row -->
        <div class="content-row">
            <!-- Temporary Residence -->
            <div class="content-card">
                <div class="content-card-header">
                    <h3 class="content-card-title"><i class="fas fa-sign-in-alt"></i> Tạm trú đang có hiệu lực</h3>
                    <a href="/toquan/tamtrutamvang" class="btn-action btn-secondary"><i class="fas fa-list"></i> Xem tất cả</a>
                </div>
                <div class="content-card-body">
                    <div class="table-responsive">
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>Họ tên</th>
                                    <th>Địa chỉ tạm trú</th>
                                    <th>Thời hạn</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Dữ liệu mẫu - sẽ được thay thế bằng dữ liệu thực từ server -->
                                <tr>
                                    <td>
                                        <div class="resident-info">
                                            <div class="resident-avatar"><i class="fas fa-user"></i></div>
                                            <span>Phạm Văn D</span>
                                        </div>
                                    </td>
                                    <td>Căn hộ B0301, BlueMoon Apartment</td>
                                    <td>10/03/2025 - 10/09/2025</td>
                                    <td><span class="status-badge badge-add">Đã duyệt</span></td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="resident-info">
                                            <div class="resident-avatar"><i class="fas fa-user"></i></div>
                                            <span>Hoàng Thị E</span>
                                        </div>
                                    </td>
                                    <td>Căn hộ A0102, BlueMoon Apartment</td>
                                    <td>05/04/2025 - 05/10/2025</td>
                                    <td><span class="status-badge badge-add">Đã duyệt</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <!-- Temporary Absence -->
            <div class="content-card">
                <div class="content-card-header">
                    <h3 class="content-card-title"><i class="fas fa-sign-out-alt"></i> Tạm vắng đang có hiệu lực</h3>
                    <a href="/toquan/tamtrutamvang" class="btn-action btn-secondary"><i class="fas fa-list"></i> Xem tất cả</a>
                </div>
                <div class="content-card-body">
                    <div class="table-responsive">
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>Họ tên</th>
                                    <th>Nơi tạm trú</th>
                                    <th>Thời hạn</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Dữ liệu mẫu - sẽ được thay thế bằng dữ liệu thực từ server -->
                                <tr>
                                    <td>
                                        <div class="resident-info">
                                            <div class="resident-avatar"><i class="fas fa-user"></i></div>
                                            <span>Nguyễn Thị F</span>
                                        </div>
                                    </td>
                                    <td>123 Lê Lợi, Quận 1, TP. HCM</td>
                                    <td>01/05/2025 - 01/11/2025</td>
                                    <td><span class="status-badge badge-move">Đã duyệt</span></td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="resident-info">
                                            <div class="resident-avatar"><i class="fas fa-user"></i></div>
                                            <span>Trần Văn G</span>
                                        </div>
                                    </td>
                                    <td>456 Nguyễn Huệ, Quận 1, TP. HCM</td>
                                    <td>15/04/2025 - 15/07/2025</td>
                                    <td><span class="status-badge badge-move">Đã duyệt</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Changes -->
        <div class="content-row">
            <div class="content-card">
                <div class="content-card-header">
                    <h3 class="content-card-title"><i class="fas fa-history"></i> Biến động nhân khẩu gần đây</h3>
                    <a href="/toquan/biendoi" class="btn-action btn-secondary"><i class="fas fa-list"></i> Xem tất cả</a>
                </div>
                <div class="content-card-body">
                    <div class="table-responsive">
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th style="width: 130px;">Ngày thay đổi</th>
                                    <th>Nhân khẩu</th>
                                    <th>Hộ khẩu</th>
                                    <th style="width: 120px;">Loại thay đổi</th>
                                    <th>Nội dung</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (recentChanges && recentChanges.length > 0) { %>
                                    <% recentChanges.slice(0, 5).forEach(change => { %>
                                        <tr>
                                            <td><%= change.ngayThayDoi.toLocaleDateString('vi-VN') %></td>
                                            <td>
                                                <% if (change.nhanKhau) { %>
                                                    <div class="resident-info">
                                                        <div class="resident-avatar"><i class="fas fa-user"></i></div>
                                                        <span><%= change.nhanKhau.hoTen %></span>
                                                    </div>
                                                <% } else { %>
                                                    -
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (change.hoKhau) { %>
                                                    <%= change.hoKhau.soHoKhau %>
                                                <% } else { %>
                                                    -
                                                <% } %>
                                            </td>
                                            <td>
                                                <% let badgeClass = ''; %>
                                                <% if (change.loaiThayDoi === 'Thêm mới') { %>
                                                    <% badgeClass = 'badge-add'; %>
                                                <% } else if (change.loaiThayDoi === 'Xóa') { %>
                                                    <% badgeClass = 'badge-remove'; %>
                                                <% } else if (['Chuyển đi', 'Chuyển đến'].includes(change.loaiThayDoi)) { %>
                                                    <% badgeClass = 'badge-move'; %>
                                                <% } else { %>
                                                    <% badgeClass = 'badge-temp'; %>
                                                <% } %>
                                                <span class="status-badge <%= badgeClass %>"><%= change.loaiThayDoi %></span>
                                            </td>
                                            <td><%= change.noiDung %></td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5">
                                            <div class="empty-state">
                                                <i class="fas fa-info-circle"></i>
                                                <div class="empty-state-text">Không có biến động nhân khẩu gần đây</div>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

