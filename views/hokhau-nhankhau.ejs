                <a href="/toquan/nhankhau/add" class="btn-action" style="background-color: var(--secondary-color);">
                    <i class="fas fa-user-plus"></i> Thêm nhân khẩu
                </a>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="tab-navigation">
            <button class="tab-btn active" id="hokhau-tab">Hộ khẩu</button>
            <button class="tab-btn" id="nhankhau-tab">Nhân khẩu</button>
        </div>

