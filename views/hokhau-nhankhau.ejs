<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Hộ Khẩu & Nhân Khẩu - BlueMoon</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Style từ file cũ giữ nguyên */
        :root {
            --primary-color: #2a9d8f;
            --secondary-color: #264653;
            --light-color: #e9c46a;
            --accent-color: #f4a261;
            --dark-color: #e76f51;
            --sidebar-width: 250px;
            --border-radius: 12px;
            --card-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            --transition-speed: 0.3s;
        }
        
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fc;
            color: #333;
        }
        
        /* Enhanced Sidebar */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: linear-gradient(180deg, var(--secondary-color) 0%, #1d3a47 100%);
            position: fixed;
            left: 0;
            top: 0;
            color: white;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
            z-index: 100;
            transition: width var(--transition-speed);
        }
        
        .sidebar-header {
            padding: 25px;
            font-size: 28px;
            font-weight: bold;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.05);
            letter-spacing: 1px;
        }
        
        .sidebar-menu {
            padding: 25px 0;
            overflow-y: auto;
            max-height: calc(100vh - 180px);
        }
        
        .menu-item {
            padding: 16px 25px;
            cursor: pointer;
            transition: all var(--transition-speed);
            display: flex;
            align-items: center;
            font-size: 17px;
            text-decoration: none;
            color: rgba(255, 255, 255, 0.85);
            border-left: 3px solid transparent;
        }
        
        .menu-item:hover {
            background-color: rgba(42, 157, 143, 0.2);
            color: white;
            transform: translateX(3px);
        }
        
        .menu-item.active {
            background: linear-gradient(90deg, rgba(42, 157, 143, 0.2) 0%, rgba(42, 157, 143, 0) 100%);
            border-left: 3px solid var(--primary-color);
            color: white;
            font-weight: 500;
        }
        
        .menu-item i {
            margin-right: 15px;
            width: 24px;
            text-align: center;
            font-size: 18px;
            opacity: 0.9;
        }
        
        .logout-btn {
            position: absolute;
            bottom: 20px;
            width: 100%;
            padding: 16px 25px;
            cursor: pointer;
            transition: all var(--transition-speed);
            display: flex;
            align-items: center;
            font-size: 17px;
            color: rgba(255, 255, 255, 0.85);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .logout-btn:hover {
            background-color: rgba(231, 111, 81, 0.2);
            color: white;
        }
        
        .logout-btn i {
            margin-right: 15px;
            font-size: 18px;
        }
        
        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 25px;
            transition: margin var(--transition-speed);
        }
        
        .page-header {
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .page-title {
            font-size: 26px;
            font-weight: 600;
            color: var(--secondary-color);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
        }
        
        .page-title i {
            margin-right: 12px;
            font-size: 28px;
            color: var(--primary-color);
        }
        
        .page-subtitle {
            color: #6c757d;
            font-size: 15px;
            margin-bottom: 0;
        }
        
        /* Tab Navigation */
        .tab-navigation {
            display: flex;
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding-left: 10px;
        }
        
        .tab-btn {
            padding: 10px 20px;
            margin-right: 5px;
            cursor: pointer;
            background-color: transparent;
            border: none;
            border-bottom: 3px solid transparent;
            font-weight: 500;
            transition: all 0.2s;
            color: #6c757d;
            position: relative;
            top: 1px;
        }
        
        .tab-btn.active {
            color: var(--primary-color);
            border-bottom: 3px solid var(--primary-color);
        }
        
        .tab-btn:hover:not(.active) {
            color: var(--dark-color);
            border-bottom: 3px solid rgba(231, 111, 81, 0.3);
        }
        
        /* Content Cards */
        .content-card {
            background-color: white;
            border-radius: var(--border-radius);
            box-shadow: var(--card-shadow);
            overflow: hidden;
            margin-bottom: 20px;
        }
        
        .content-card-header {
            padding: 18px 20px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .content-card-title {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
            color: var(--secondary-color);
            display: flex;
            align-items: center;
        }
        
        .content-card-title i {
            margin-right: 10px;
            font-size: 16px;
            color: var(--primary-color);
        }
        
        .content-card-body {
            padding: 20px;
        }
        
        /* Data Tables */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }
        
        .custom-table {
            width: 100%;
            margin-bottom: 0;
        }
        
        .custom-table th {
            background-color: rgba(42, 157, 143, 0.05);
            color: var(--secondary-color);
            font-weight: 600;
            white-space: nowrap;
            padding: 12px 15px;
            font-size: 14px;
            border-bottom: 2px solid rgba(0, 0, 0, 0.05);
        }
        
        .custom-table td {
            padding: 12px 15px;
            vertical-align: middle;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            font-size: 14px;
        }
        
        .custom-table tbody tr:last-child td {
            border-bottom: none;
        }
        
        .custom-table tbody tr:hover {
            background-color: rgba(42, 157, 143, 0.03);
        }
        
        /* Household Table Styles */
        .household-table-container {
            margin-top: 20px;
        }
        
        .household-table td {
            padding: 12px 15px;
        }
        
        .household-header {
            background-color: rgba(38, 70, 83, 0.05);
            font-weight: 600;
            cursor: pointer;
        }
        
        .resident-row {
            background-color: rgba(42, 157, 143, 0.02);
        }
        
        .resident-info {
            display: flex;
            align-items: center;
        }
        
        .resident-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: rgba(42, 157, 143, 0.1);
            color: var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            font-size: 14px;
        }
        
        /* Status Badge */
        .status-badge {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            display: inline-block;
        }
        
        .status-active {
            background-color: rgba(42, 157, 143, 0.1);
            color: var(--primary-color);
        }
        
        .status-inactive {
            background-color: rgba(231, 111, 81, 0.1);
            color: var(--dark-color);
        }
        
        .status-pending {
            background-color: rgba(233, 196, 106, 0.1);
            color: var(--light-color);
        }
        
        .status-approved {
            background-color: rgba(42, 157, 143, 0.1);
            color: var(--primary-color);
        }
        
        .status-rejected {
            background-color: rgba(231, 111, 81, 0.1);
            color: var(--dark-color);
        }
        
        /* Action Buttons */
        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 4px;
            background-color: rgba(38, 70, 83, 0.1);
            color: var(--secondary-color);
            border: none;
            margin-right: 5px;
            transition: all 0.2s;
        }
        
        .action-btn:hover {
            background-color: var(--primary-color);
            color: white;
        }
        
        .action-btn-delete:hover {
            background-color: var(--dark-color);
            color: white;
        }
        
        .action-btn-view:hover {
            background-color: var(--light-color);
            color: #333;
        }
        
        .btn-action {
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 6px;
            padding: 8px 16px;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            text-decoration: none;
        }
        
        .btn-action:hover {
            background-color: #248a7c;
            transform: translateY(-2px);
            color: white;
        }
        
        .btn-action i {
            margin-right: 6px;
        }
        
        /* Search Box */
        .search-container {
            position: relative;
            margin-bottom: 20px;
        }
        
        .search-box {
            width: 100%;
            padding: 12px 15px 12px 40px;
            border-radius: 8px;
            border: 1px solid rgba(0, 0, 0, 0.1);
            font-size: 14px;
            transition: all 0.2s;
        }
        
        .search-box:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(42, 157, 143, 0.25);
            outline: none;
        }
        
        .search-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
        }
        
        /* Header Actions */
        .header-actions {
            display: flex;
            gap: 10px;
        }
        
        /* Pagination */
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .pagination-info {
            color: #6c757d;
            font-size: 14px;
        }
        
        .pagination {
            display: flex;
            gap: 5px;
        }
        
        .page-btn {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
            background-color: #f8f9fa;
            color: #6c757d;
            border: 1px solid rgba(0, 0, 0, 0.1);
            transition: all 0.2s;
            cursor: pointer;
            font-size: 14px;
        }
        
        .page-btn.active {
            background-color: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
        }
        
        .page-btn:hover:not(.active) {
            background-color: rgba(42, 157, 143, 0.1);
            color: var(--primary-color);
        }
        
        .page-btn.disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        /* Empty State */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
            text-align: center;
        }
        
        .empty-state i {
            font-size: 48px;
            color: rgba(42, 157, 143, 0.2);
            margin-bottom: 15px;
        }
        
        .empty-state-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 10px;
            color: #333;
        }
        
        .empty-state-text {
            color: #6c757d;
            max-width: 500px;
            margin-bottom: 20px;
        }
        
        /* Tab content visibility */
        .tab-content {
            display: none;
        }
        
        .tab-content.active {
            display: block;
        }
        
        /* Responsive Styles */
        @media (max-width: 768px) {
            .sidebar {
                width: 200px;
            }
            
            .main-content {
                margin-left: 200px;
            }
            
            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .header-actions {
                margin-top: 15px;
                width: 100%;
                justify-content: space-between;
            }
        }
        
        @media (max-width: 576px) {
            .sidebar {
                width: 70px;
            }
            
            .sidebar-header {
                font-size: 18px;
                padding: 15px 0;
            }
            
            .menu-item span,
            .logout-btn span {
                display: none;
            }
            
            .menu-item i,
            .logout-btn i {
                margin-right: 0;
            }
            
            .main-content {
                margin-left: 70px;
                padding: 15px;
            }
            
            .tab-btn {
                padding: 10px;
                font-size: 13px;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            BLUEMOON
        </div>
        <div class="sidebar-menu">
            <a href="/toquan/dashboard" class="menu-item">
                <i class="fas fa-tachometer-alt"></i>
                <span>Trang chủ</span>
            </a>
            <a href="/toquan/hokhau-nhankhau" class="menu-item active">
                <i class="fas fa-house-user"></i>
                <span>Quản lý hộ khẩu</span>
            </a>
            <a href="/admin/parking/registrations" class="menu-item">
                <i class="fas fa-car"></i>
                <span>Quản lý xe</span>
            </a>
            <a href="/toquan/thongke" class="menu-item">
                <i class="fas fa-chart-bar"></i>
                <span>Thống kê</span>
            </a>
            <a href="/toquan/bao-cao" class="menu-item">
                <i class="fas fa-file-alt"></i>
                <span>Phản ánh của cư dân</span>
            </a>
        </div>
        <div class="logout-btn">
            <a href="/logout" style="color: inherit; text-decoration: none; display: flex; align-items: center; width: 100%;">
                <i class="fas fa-sign-out-alt"></i>
                <span>ĐĂNG XUẤT</span>
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="page-header">
            <div class="page-title-container">
                <h1 class="page-title">
                    <i class="fas fa-house-user"></i>
                    Quản Lý Hộ Khẩu & Nhân Khẩu
                </h1>
                <p class="page-subtitle">Quản lý thông tin hộ khẩu, nhân khẩu và tạm trú tạm vắng trong chung cư</p>
            </div>
            <div class="header-actions">
                <a href="/toquan/hokhau/add" class="btn-action">
                    <i class="fas fa-plus"></i> Thêm hộ khẩu
                </a>
                <a href="/toquan/nhankhau/add" class="btn-action" style="background-color: var(--secondary-color);">
                    <i class="fas fa-user-plus"></i> Thêm nhân khẩu
                </a>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="tab-navigation">
            <button class="tab-btn active" id="hokhau-tab">Hộ khẩu</button>
            <button class="tab-btn" id="nhankhau-tab">Nhân khẩu</button>
            <button class="tab-btn" id="tamtru-tab">Tạm trú tạm vắng</button>
        </div>

        <!-- Hộ Khẩu Tab Content -->
        <div class="tab-content active" id="hokhau-content">
            <!-- Search Box -->
            <div class="search-container">
                <input type="text" class="search-box" id="hokhau-search" placeholder="Tìm kiếm hộ khẩu theo số, chủ hộ hoặc địa chỉ...">
                <i class="fas fa-search search-icon"></i>
            </div>

            <!-- Hộ Khẩu Table -->
            <div class="content-card">
                <div class="content-card-body">
                    <div class="table-responsive">
                        <table class="custom-table household-table">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Số hộ khẩu</th>
                                    <th>Chủ hộ</th>
                                    <th>Địa chỉ</th>
                                    <th>Số thành viên</th>
                                    <th>Ngày cấp</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof hokhauList !== 'undefined' && hokhauList && hokhauList.length > 0) { %>
                                    <% hokhauList.forEach(function(hokhau, index) { %>
                                        <tr class="household-header" data-household="<%= hokhau._id %>">
                                            <td><%= index + 1 %></td>
                                            <td><%= hokhau.soHoKhau %></td>
                                            <td><%= hokhau.hoTenChuHo %></td>
                                            <td><%= hokhau.diaChi %></td>
                                            <td><%= hokhau.memberCount || 0 %></td>
                                            <td><%= hokhau.ngayLamHoKhau ? new Date(hokhau.ngayLamHoKhau).toLocaleDateString('vi-VN') : '-' %></td>
                                            <td><span class="status-badge status-active">Hoạt động</span></td>
                                            <td>
                                                <a href="/toquan/hokhau/<%= hokhau._id %>" class="action-btn action-btn-view" title="Xem chi tiết">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="/toquan/hokhau/<%= hokhau._id %>/edit" class="action-btn" title="Chỉnh sửa">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <button class="action-btn action-btn-delete" title="Xóa" data-id="<%= hokhau._id %>">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                        <% if (hokhau.members && hokhau.members.length > 0) { %>
                                            <% hokhau.members.forEach(function(member) { %>
                                                <tr class="resident-row" data-household="<%= hokhau._id %>" style="display: none;">
                                                    <td></td>
                                                    <td colspan="2">
                                                        <div class="resident-info">
                                                            <div class="resident-avatar">
                                                                <i class="fas fa-user"></i>
                                                            </div>
                                                            <span><%= member.hoTen %></span>
                                                        </div>
                                                    </td>
                                                    <td><%= member.quanHeVoiChuHo %></td>
                                                    <td><%= member.ngaySinh ? new Date(member.ngaySinh).toLocaleDateString('vi-VN') : '-' %></td>
                                                    <td><%= member.gioiTinh %></td>
                                                    <td><%= member.cccd || '-' %></td>
                                                    <td>
                                                        <a href="/toquan/nhankhau/<%= member._id %>" class="action-btn action-btn-view" title="Xem chi tiết">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        <% } %>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <div class="empty-state">
                                                <i class="fas fa-inbox"></i>
                                                <h3 class="empty-state-title">Không có dữ liệu hộ khẩu</h3>
                                                <p class="empty-state-text">Chưa có hộ khẩu nào được đăng ký. Vui lòng thêm hộ khẩu mới bằng cách nhấn vào nút "Thêm hộ khẩu".</p>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Nhân Khẩu Tab Content -->
        <div class="tab-content" id="nhankhau-content">
            <!-- Search Box -->
            <div class="search-container">
                <input type="text" class="search-box" id="nhankhau-search" placeholder="Tìm kiếm nhân khẩu theo tên, CCCD/CMND...">
                <i class="fas fa-search search-icon"></i>
            </div>

            <!-- Nhân Khẩu Table -->
            <div class="content-card">
                <div class="content-card-body">
                    <div class="table-responsive">
                        <table class="custom-table" id="nhankhau-table">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Họ tên</th>
                                    <th>Ngày sinh</th>
                                    <th>Giới tính</th>
                                    <th>Hộ khẩu</th>
                                    <th>Quan hệ với chủ hộ</th>
                                    <th>CCCD/CMND</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof nhankhauList !== 'undefined' && nhankhauList && nhankhauList.length > 0) { %>
                                    <% nhankhauList.forEach(function(nhankhau, index) { %>
                                        <tr>
                                            <td><%= index + 1 %></td>
                                            <td>
                                                <div class="resident-info">
                                                    <div class="resident-avatar">
                                                        <i class="fas fa-user"></i>
                                                    </div>
                                                    <span><%= nhankhau.hoTen %></span>
                                                </div>
                                            </td>
                                            <td><%= nhankhau.ngaySinh ? new Date(nhankhau.ngaySinh).toLocaleDateString('vi-VN') : '-' %></td>
                                            <td><%= nhankhau.gioiTinh %></td>
                                            <td><%= nhankhau.hoKhau ? nhankhau.hoKhau.soHoKhau : '-' %></td>
                                            <td><%= nhankhau.quanHeVoiChuHo %></td>
                                            <td><%= nhankhau.cccd || '-' %></td>
                                            <td>
                                                <a href="/toquan/nhankhau/<%= nhankhau._id %>" class="action-btn action-btn-view" title="Xem chi tiết">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="/toquan/nhankhau/<%= nhankhau._id %>/edit" class="action-btn" title="Chỉnh sửa">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <button class="action-btn action-btn-delete" title="Xóa" onclick="confirmDeleteNhanKhau('<%= nhankhau._id %>')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <div class="empty-state">
                                                <i class="fas fa-users"></i>
                                                <h3 class="empty-state-title">Không có dữ liệu nhân khẩu</h3>
                                                <p class="empty-state-text">Chưa có nhân khẩu nào được đăng ký. Vui lòng thêm nhân khẩu mới bằng cách nhấn vào nút "Thêm nhân khẩu".</p>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tạm Trú Tạm Vắng Tab Content -->
        <div class="tab-content" id="tamtru-content">
            <div class="header-actions" style="margin-bottom: 20px;">
                <a href="/toquan/tamtru/add" class="btn-action">
                    <i class="fas fa-plus"></i> Đăng ký tạm trú
                </a>
                <a href="/toquan/tamvang/add" class="btn-action" style="background-color: var(--secondary-color);">
                    <i class="fas fa-plus"></i> Đăng ký tạm vắng
                </a>
            </div>

            <!-- Sub Tab Navigation for Temporary Residence -->
            <div class="tab-navigation">
                <button class="tab-btn active" id="tamtru-sub-tab">Tạm trú</button>
                <button class="tab-btn" id="tamvang-sub-tab">Tạm vắng</button>
            </div>

            <!-- Tạm Trú Content -->
            <div class="tab-content active" id="tamtru-sub-content">
                <!-- Search Box -->
                <div class="search-container">
                    <input type="text" class="search-box" id="tamtru-search" placeholder="Tìm kiếm tạm trú...">
                    <i class="fas fa-search search-icon"></i>
                </div>

                <!-- Tạm Trú Table -->
                <div class="content-card">
                    <div class="content-card-body">
                        <div class="table-responsive">
                            <table class="custom-table" id="tamtru-table">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Người đăng ký</th>
                                        <th>Địa chỉ tạm trú</th>
                                        <th>Thời gian</th>
                                        <th>Lý do</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (typeof tamTruList !== 'undefined' && tamTruList && tamTruList.length > 0) { %>
                                        <% tamTruList.forEach((tamTru, index) => { %>
                                            <tr>
                                                <td><%= index + 1 %></td>
                                                <td>
                                                    <div class="resident-info">
                                                        <div class="resident-avatar">
                                                            <i class="fas fa-user"></i>
                                                        </div>
                                                        <%= tamTru.nhanKhau ? tamTru.nhanKhau.hoTen : 'N/A' %>
                                                    </div>
                                                </td>
                                                <td><%= tamTru.diaChiTamTru %></td>
                                                <td>
                                                    <%= new Date(tamTru.tuNgay).toLocaleDateString('vi-VN') %> - 
                                                    <%= new Date(tamTru.denNgay).toLocaleDateString('vi-VN') %>
                                                </td>
                                                <td><%= tamTru.lyDo || 'Không có' %></td>
                                                <td>
                                                    <% if (tamTru.trangThai === 'Chờ duyệt') { %>
                                                        <span class="status-badge status-pending">Chờ duyệt</span>
                                                    <% } else if (tamTru.trangThai === 'Đã duyệt') { %>
                                                        <span class="status-badge status-approved">Đã duyệt</span>
                                                    <% } else { %>
                                                        <span class="status-badge status-rejected">Từ chối</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <a href="/toquan/tamtru/<%= tamTru._id %>" class="action-btn" title="Xem chi tiết">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="/toquan/tamtru/<%= tamTru._id %>/edit" class="action-btn" title="Chỉnh sửa">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button class="action-btn action-btn-delete" title="Xóa" onclick="confirmDelete('tamtru', '<%= tamTru._id %>')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7">
                                                <div class="empty-state">
                                                    <i class="fas fa-house-user"></i>
                                                    <h3 class="empty-state-title">Không có dữ liệu tạm trú</h3>
                                                    <p class="empty-state-text">Chưa có thông tin tạm trú nào được đăng ký. Vui lòng thêm mới bằng cách nhấn vào nút "Đăng ký tạm trú".</p>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tạm Vắng Content -->
            <div class="tab-content" id="tamvang-sub-content">
                <!-- Search Box -->
                <div class="search-container">
                    <input type="text" class="search-box" id="tamvang-search" placeholder="Tìm kiếm tạm vắng...">
                    <i class="fas fa-search search-icon"></i>
                </div>

                <!-- Tạm Vắng Table -->
                <div class="content-card">
                    <div class="content-card-body">
                        <div class="table-responsive">
                            <table class="custom-table" id="tamvang-table">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Người đăng ký</th>
                                        <th>Nơi tạm trú</th>
                                        <th>Thời gian</th>
                                        <th>Lý do</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (typeof tamVangList !== 'undefined' && tamVangList && tamVangList.length > 0) { %>
                                        <% tamVangList.forEach((tamVang, index) => { %>
                                            <tr>
                                                <td><%= index + 1 %></td>
                                                <td>
                                                    <div class="resident-info">
                                                        <div class="resident-avatar">
                                                            <i class="fas fa-user"></i>
                                                        </div>
                                                        <%= tamVang.nhanKhau ? tamVang.nhanKhau.hoTen : 'N/A' %>
                                                    </div>
                                                </td>
                                                <td><%= tamVang.noiTamTru %></td>
                                                <td>
                                                    <%= new Date(tamVang.tuNgay).toLocaleDateString('vi-VN') %> - 
                                                    <%= new Date(tamVang.denNgay).toLocaleDateString('vi-VN') %>
                                                </td>
                                                <td><%= tamVang.lyDo || 'Không có' %></td>
                                                <td>
                                                    <% if (tamVang.trangThai === 'Chờ duyệt') { %>
                                                        <span class="status-badge status-pending">Chờ duyệt</span>
                                                    <% } else if (tamVang.trangThai === 'Đã duyệt') { %>
                                                        <span class="status-badge status-approved">Đã duyệt</span>
                                                    <% } else { %>
                                                        <span class="status-badge status-rejected">Từ chối</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <a href="/toquan/tamvang/<%= tamVang._id %>" class="action-btn" title="Xem chi tiết">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="/toquan/tamvang/<%= tamVang._id %>/edit" class="action-btn" title="Chỉnh sửa">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button class="action-btn action-btn-delete" title="Xóa" onclick="confirmDelete('tamvang', '<%= tamVang._id %>')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7">
                                                <div class="empty-state">
                                                    <i class="fas fa-house-user"></i>
                                                    <h3 class="empty-state-title">Không có dữ liệu tạm vắng</h3>
                                                    <p class="empty-state-text">Chưa có thông tin tạm vắng nào được đăng ký. Vui lòng thêm mới bằng cách nhấn vào nút "Đăng ký tạm vắng".</p>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Main Tab Switching
            const hokhauTab = document.getElementById('hokhau-tab');
            const nhankhauTab = document.getElementById('nhankhau-tab');
            const tamtruTab = document.getElementById('tamtru-tab');
            
            const hokhauContent = document.getElementById('hokhau-content');
            const nhankhauContent = document.getElementById('nhankhau-content');
            const tamtruContent = document.getElementById('tamtru-content');
            
            function switchMainTab(activeTab, activeContent) {
                // Remove active class from all tabs and contents
                [hokhauTab, nhankhauTab, tamtruTab].forEach(tab => tab.classList.remove('active'));
                [hokhauContent, nhankhauContent, tamtruContent].forEach(content => content.classList.remove('active'));
                
                // Add active class to selected tab and content
                activeTab.classList.add('active');
                activeContent.classList.add('active');
            }
            
            hokhauTab.addEventListener('click', () => switchMainTab(hokhauTab, hokhauContent));
            nhankhauTab.addEventListener('click', () => switchMainTab(nhankhauTab, nhankhauContent));
            tamtruTab.addEventListener('click', () => switchMainTab(tamtruTab, tamtruContent));
            
            // Sub Tab Switching for Temporary Residence
            const tamtruSubTab = document.getElementById('tamtru-sub-tab');
            const tamvangSubTab = document.getElementById('tamvang-sub-tab');
            const tamtruSubContent = document.getElementById('tamtru-sub-content');
            const tamvangSubContent = document.getElementById('tamvang-sub-content');
            
            function switchSubTab(activeTab, activeContent) {
                [tamtruSubTab, tamvangSubTab].forEach(tab => tab.classList.remove('active'));
                [tamtruSubContent, tamvangSubContent].forEach(content => content.classList.remove('active'));
                
                activeTab.classList.add('active');
                activeContent.classList.add('active');
            }
            
            if (tamtruSubTab && tamvangSubTab) {
                tamtruSubTab.addEventListener('click', () => switchSubTab(tamtruSubTab, tamtruSubContent));
                tamvangSubTab.addEventListener('click', () => switchSubTab(tamvangSubTab, tamvangSubContent));
            }
            
            // Toggle Household Details
            const householdHeaders = document.querySelectorAll('.household-header');
            
            householdHeaders.forEach(header => {
                header.addEventListener('click', function() {
                    const householdId = this.getAttribute('data-household');
                    const residentRows = document.querySelectorAll(`.resident-row[data-household="${householdId}"]`);
                    
                    residentRows.forEach(row => {
                        if (row.style.display === 'none' || !row.style.display) {
                            row.style.display = 'table-row';
                            header.classList.add('expanded');
                        } else {
                            row.style.display = 'none';
                            header.classList.remove('expanded');
                        }
                    });
                });
            });
            
            // Search functionality for household table
            const hokhauSearch = document.getElementById('hokhau-search');
            if (hokhauSearch) {
                hokhauSearch.addEventListener('keyup', function() {
                    const searchValue = this.value.toLowerCase();
                    const householdRows = document.querySelectorAll('#hokhau-content .household-header');
                    
                    householdRows.forEach(row => {
                        const sohokhau = row.querySelector('td:nth-child(2)').textContent.toLowerCase();
                        const chuho = row.querySelector('td:nth-child(3)').textContent.toLowerCase();
                        const diachi = row.querySelector('td:nth-child(4)').textContent.toLowerCase();
                        
                        if (sohokhau.includes(searchValue) || chuho.includes(searchValue) || diachi.includes(searchValue)) {
                            row.style.display = 'table-row';
                        } else {
                            row.style.display = 'none';
                            // Hide related resident rows
                            const householdId = row.getAttribute('data-household');
                            const relatedRows = document.querySelectorAll(`.resident-row[data-household="${householdId}"]`);
                            relatedRows.forEach(relatedRow => {
                                relatedRow.style.display = 'none';
                            });
                        }
                    });
                });
            }
            
            // Xóa hộ khẩu
            const deleteButtons = document.querySelectorAll('.action-btn-delete');
            deleteButtons.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation(); // Ngăn hiệu ứng click vào hộ khẩu
                    
                    const id = this.getAttribute('data-id');
                    if (confirm('Bạn có chắc chắn muốn xóa hộ khẩu này?')) {
                        // Thực hiện xóa (có thể dùng fetch API để gọi server)
                        window.location.href = `/toquan/hokhau/${id}/delete`;
                    }
                });
            });
        });
        
        // Confirm delete function for temporary residence
        function confirmDelete(type, id) {
            if (confirm(`Bạn có chắc chắn muốn xóa thông tin này?`)) {
                window.location.href = `/toquan/${type}/${id}/delete`;
            }
        }
        
        // Confirm delete function for nhan khau
        function confirmDeleteNhanKhau(id) {
            if (confirm('Bạn có chắc chắn muốn xóa nhân khẩu này?')) {
                window.location.href = `/toquan/nhankhau/${id}/delete`;
            }
        }
        
        // Search functionality for temporary residence tables
        document.addEventListener('DOMContentLoaded', function() {
            // Tìm kiếm tạm trú
            const tamtruSearch = document.getElementById('tamtru-search');
            if (tamtruSearch) {
                tamtruSearch.addEventListener('keyup', function() {
                    const searchText = this.value.toLowerCase();
                    const table = document.getElementById('tamtru-table');
                    const rows = table.getElementsByTagName('tr');
                    
                    for (let i = 1; i < rows.length; i++) {
                        const row = rows[i];
                        // Bỏ qua hàng empty state
                        if (row.getElementsByTagName('td').length === 1) continue;
                        
                        let found = false;
                        const cells = row.getElementsByTagName('td');
                        
                        for (let j = 1; j < cells.length - 1; j++) {
                            const cellText = cells[j].textContent.toLowerCase();
                            if (cellText.includes(searchText)) {
                                found = true;
                                break;
                            }
                        }
                        
                        row.style.display = found ? '' : 'none';
                    }
                });
            }
            
            // Tìm kiếm tạm vắng
            const tamvangSearch = document.getElementById('tamvang-search');
            if (tamvangSearch) {
                tamvangSearch.addEventListener('keyup', function() {
                    const searchText = this.value.toLowerCase();
                    const table = document.getElementById('tamvang-table');
                    const rows = table.getElementsByTagName('tr');
                    
                    for (let i = 1; i < rows.length; i++) {
                        const row = rows[i];
                        // Bỏ qua hàng empty state
                        if (row.getElementsByTagName('td').length === 1) continue;
                        
                        let found = false;
                        const cells = row.getElementsByTagName('td');
                        
                        for (let j = 1; j < cells.length - 1; j++) {
                            const cellText = cells[j].textContent.toLowerCase();
                            if (cellText.includes(searchText)) {
                                found = true;
                                break;
                            }
                        }
                        
                        row.style.display = found ? '' : 'none';
                    }
                });
            }
        });
    </script>
</body>
</html>