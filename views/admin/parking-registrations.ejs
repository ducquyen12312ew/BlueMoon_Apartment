<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý đăng ký xe - BlueMoon Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css">
    <style>
        :root {
            --primary-color: #2a9d8f;
            --secondary-color: #264653;
            --light-color: #e9c46a;
            --accent-color: #f4a261;
            --dark-color: #e76f51;
            --sidebar-width: 250px;
            --border-radius: 12px;
            --card-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            --transition-speed: 0.3s;
        }
        
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fc;
        }
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: linear-gradient(180deg, var(--secondary-color) 0%, #1d3a47 100%);
            position: fixed;
            left: 0;
            top: 0;
            color: white;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
            z-index: 100;
            transition: width var(--transition-speed);
        }
        
        .sidebar-header {
            padding: 25px;
            font-size: 28px;
            font-weight: bold;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.05);
            letter-spacing: 1px;
        }
        
        .sidebar-menu {
            padding: 25px 0;
            overflow-y: auto;
            max-height: calc(100vh - 180px);
        }
        
        .menu-item {
            padding: 16px 25px;
            cursor: pointer;
            transition: all var(--transition-speed);
            display: flex;
            align-items: center;
            font-size: 17px;
            text-decoration: none;
            color: rgba(255, 255, 255, 0.85);
            border-left: 3px solid transparent;
        }
        
        .menu-item:hover {
            background-color: rgba(42, 157, 143, 0.2);
            color: white;
            transform: translateX(3px);
        }
        
        .menu-item.active {
            background: linear-gradient(90deg, rgba(42, 157, 143, 0.2) 0%, rgba(42, 157, 143, 0) 100%);
            border-left: 3px solid var(--primary-color);
            color: white;
            font-weight: 500;
        }
        
        .menu-item i {
            margin-right: 15px;
            width: 24px;
            text-align: center;
            font-size: 18px;
            opacity: 0.9;
        }
        
        .logout-btn {
            position: absolute;
            bottom: 20px;
            width: 100%;
            padding: 16px 25px;
            cursor: pointer;
            transition: all var(--transition-speed);
            display: flex;
            align-items: center;
            font-size: 17px;
            color: rgba(255, 255, 255, 0.85);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .logout-btn:hover {
            background-color: rgba(231, 111, 81, 0.2);
            color: white;
        }
        
        .logout-btn i {
            margin-right: 15px;
            font-size: 18px;
        }
        
        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 20px;
        }
        
        .page-header {
            display: flex;
            justify-content: between;
            align-items: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #dee2e6;
            padding-bottom: 15px;
        }
        
        .page-title {
            font-size: 28px;
            font-weight: bold;
            color: var(--primary-blue);
            margin: 0;
            display: flex;
            align-items: center;
        }
        
        .page-title i {
            margin-right: 15px;
        }
        
        /* Stats Cards */
        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            border-left: 4px solid;
            transition: all 0.3s;
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }
        
        .stat-card.pending {
            border-left-color: #ffc107;
        }
        
        .stat-card.active {
            border-left-color: #28a745;
        }
        
        .stat-card.suspended {
            border-left-color: #dc3545;
        }
        
        .stat-number {
            font-size: 36px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        
        .stat-label {
            color: #6c757d;
            font-size: 14px;
            font-weight: 500;
            text-transform: uppercase;
        }
        
        /* Filter Section */
        .filter-section {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            margin-bottom: 30px;
        }
        
        .filter-form {
            display: flex;
            gap: 15px;
            align-items: end;
            flex-wrap: wrap;
        }
        
        .filter-group {
            flex: 1;
            min-width: 200px;
        }
        
        .filter-group label {
            font-weight: 600;
            color: var(--primary-blue);
            margin-bottom: 5px;
            display: block;
        }
        
        .filter-group select {
            width: 100%;
            padding: 10px 15px;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            font-size: 16px;
            transition: all 0.3s;
        }
        
        .filter-group select:focus {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
            outline: none;
        }
        
        .btn-filter {
            background: var(--primary-blue);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .btn-filter:hover {
            background: var(--dark-blue);
        }
        
        .btn-reset {
            background: #6c757d;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .btn-reset:hover {
            background: #5a6268;
        }
        
        /* Table Container */
        .table-container {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }
        
        .table-header {
            display: flex;
            justify-content: between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid #dee2e6;
        }
        
        .table-title {
            font-size: 20px;
            font-weight: bold;
            color: var(--primary-blue);
            margin: 0;
        }
        
        /* DataTable Styles */
        .table {
            width: 100%;
            margin-bottom: 0;
        }
        
        .table th {
            background-color: #f8f9fc;
            color: #333;
            font-weight: 600;
            border-bottom: 2px solid #e3e6f0;
            padding: 15px 10px;
            text-align: center;
        }
        
        .table td {
            padding: 15px 10px;
            vertical-align: middle;
            border-bottom: 1px solid #e3e6f0;
            text-align: center;
        }
        
        .table-striped tbody tr:nth-of-type(odd) {
            background-color: #f8f9fc;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(78, 115, 223, 0.05);
        }
        
        /* Status badges */
        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            display: inline-block;
        }
        
        .status-pending {
            background-color: #fff3cd;
            color: #856404;
        }
        
        .status-active {
            background-color: #d4edda;
            color: #155724;
        }
        
        .status-suspended {
            background-color: #f8d7da;
            color: #721c24;
        }
        
        .status-cancelled {
            background-color: #e2e3e5;
            color: #383d41;
        }
        
        /* Vehicle type badges */
        .vehicle-type {
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }
        
        .type-car {
            background-color: #e3f2fd;
            color: #1976d2;
        }
        
        .type-motorbike {
            background-color: #f3e5f5;
            color: #7b1fa2;
        }
        
        .type-bicycle {
            background-color: #e8f5e8;
            color: #388e3c;
        }
        
        /* Action buttons */
        .btn-action {
            padding: 6px 12px;
            border: none;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            margin: 0 2px;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-approve {
            background-color: #28a745;
            color: white;
        }
        
        .btn-approve:hover {
            background-color: #218838;
            color: white;
        }
        
        .btn-reject {
            background-color: #dc3545;
            color: white;
        }
        
        .btn-reject:hover {
            background-color: #c82333;
            color: white;
        }
        
        .btn-view {
            background-color: #007bff;
            color: white;
        }
        
        .btn-view:hover {
            background-color: #0056b3;
            color: white;
        }
        
        /* Modal styles */
        .modal-header {
            background: var(--primary-blue);
            color: white;
            border-bottom: none;
        }
        
        .modal-header .btn-close {
            filter: invert(1);
        }
        
        .modal-body {
            padding: 30px;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-label {
            font-weight: 600;
            color: var(--primary-blue);
            margin-bottom: 8px;
            display: block;
        }
        
        .form-control {
            width: 100%;
            padding: 10px 15px;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            font-size: 16px;
            transition: all 0.3s;
        }
        
        .form-control:focus {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
            outline: none;
        }
        
        /* Alert styles */
        .alert {
            border-radius: 10px;
            padding: 15px 20px;
            margin-bottom: 20px;
            border: none;
            font-weight: 500;
        }
        
        .alert-success {
            background-color: #d4edda;
            color: #155724;
        }
        
        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .sidebar {
                width: 60px;
            }
            
            .sidebar-header {
                font-size: 18px;
                padding: 15px 0;
            }
            
            .menu-item span,
            .logout-btn span {
                display: none;
            }
            
            .menu-item i,
            .logout-btn i {
                margin-right: 0;
            }
            
            .main-content {
                margin-left: 60px;
                padding: 15px;
            }
            
            .stats-container {
                grid-template-columns: 1fr;
            }
            
            .filter-form {
                flex-direction: column;
            }
            
            .filter-group {
                width: 100%;
            }
            
            .table-container {
                overflow-x: auto;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            BLUEMOON
        </div>
        <div class="sidebar-menu">
            <a href="/toquan/hokhau-nhankhau" class="menu-item">
                <i class="fas fa-tachometer-alt"></i>
                <span>Trang chủ</span>
            </a>
            <a href="/toquan/hokhau-nhankhau" class="menu-item">
                <i class="fas fa-house-user"></i>
                <span>Quản lý hộ khẩu</span>
            </a>
            <a href="/admin/parking/registrations" class="menu-item active">
                <i class="fas fa-car"></i>
                <span>Quản lý xe</span>
            </a>

            <a href="/toquan/thongke" class="menu-item">
                <i class="fas fa-chart-bar"></i>
                <span>Thống kê</span>
            </a>
            <a href="/toquan/bao-cao" class="menu-item">
                <i class="fas fa-file-alt"></i>
                <span>Phản ánh của cư dân</span>
            </a>
        </div>

        <div class="logout-btn">
            <a href="/logout" style="color: white; text-decoration: none; display: flex; align-items: center;">
                <i class="fas fa-sign-out-alt"></i>
                <span>ĐĂNG XUẤT</span>
            </a>
        </div>
    </div>
   
    <!-- Main Content -->
    <div class="main-content">
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-car"></i>
                Quản lý đăng ký xe
            </h1>
        </div>

        <!-- Success/Error Messages -->
        <div id="alertContainer">
            <!-- Alerts will be shown here -->
        </div>

        <!-- Statistics Cards -->
        <div class="stats-container">
            <div class="stat-card pending">
                <div class="stat-number text-warning"><%= pendingCount %></div>
                <div class="stat-label">Chờ duyệt</div>
            </div>
            <div class="stat-card active">
                <div class="stat-number text-success"><%= activeCount %></div>
                <div class="stat-label">Đã duyệt</div>
            </div>
            <div class="stat-card suspended">
                <div class="stat-number text-danger"><%= suspendedCount %></div>
                <div class="stat-label">Tạm dừng</div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="filter-section">
            <form class="filter-form" method="GET">
                <div class="filter-group">
                    <label for="statusFilter">Trạng thái</label>
                    <select id="statusFilter" name="status">
                        <option value="">Tất cả trạng thái</option>
                        <option value="pending" <%= (currentFilter.status === 'pending') ? 'selected' : '' %>>Chờ duyệt</option>
                        <option value="active" <%= (currentFilter.status === 'active') ? 'selected' : '' %>>Đã duyệt</option>
                        <option value="suspended" <%= (currentFilter.status === 'suspended') ? 'selected' : '' %>>Tạm dừng</option>
                        <option value="cancelled" <%= (currentFilter.status === 'cancelled') ? 'selected' : '' %>>Đã hủy</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label for="vehicleTypeFilter">Loại xe</label>
                    <select id="vehicleTypeFilter" name="vehicleType">
                        <option value="">Tất cả loại xe</option>
                        <option value="car" <%= (currentFilter.vehicleType === 'car') ? 'selected' : '' %>>Ô tô</option>
                        <option value="motorbike" <%= (currentFilter.vehicleType === 'motorbike') ? 'selected' : '' %>>Xe máy</option>
                        <option value="bicycle" <%= (currentFilter.vehicleType === 'bicycle') ? 'selected' : '' %>>Xe đạp</option>
                    </select>
                </div>
                <button type="submit" class="btn-filter">
                    <i class="fas fa-filter"></i> Lọc
                </button>
                <a href="/admin/parking/registrations" class="btn-reset">
                    <i class="fas fa-undo"></i> Đặt lại
                </a>
            </form>
        </div>

        <!-- Vehicle Registration Table -->
        <div class="table-container">
            <div class="table-header">
                <h3 class="table-title">Danh sách đăng ký xe</h3>
            </div>
            
            <table id="vehicleTable" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Biển số</th>
                        <th>Loại xe</th>
                        <th>Căn hộ</th>
                        <th>Người đăng ký</th>
                        <th>Ngày đăng ký</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (registrations && registrations.length > 0) { %>
                        <% registrations.forEach(function(registration, index) { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td>
                                <strong><%= registration.licensePlate %></strong>
                                <br>
                                <small class="text-muted">
                                    <%= registration.vehicleBrand %> <%= registration.vehicleModel || '' %>
                                </small>
                            </td>
                            <td>
                                <span class="vehicle-type type-<%= registration.vehicleType %>">
                                    <%= registration.vehicleType === 'car' ? 'Ô tô' : 
                                        registration.vehicleType === 'motorbike' ? 'Xe máy' : 'Xe đạp' %>
                                </span>
                            </td>
                            <td><%= registration.apartment %></td>
                            <td><%= registration.residentName %></td>
                            <td><%= new Date(registration.registrationDate).toLocaleDateString('vi-VN') %></td>
                            <td>
                                <span class="status-badge status-<%= registration.status %>">
                                    <%= registration.status === 'pending' ? 'Chờ duyệt' : 
                                        registration.status === 'active' ? 'Đã duyệt' : 
                                        registration.status === 'suspended' ? 'Tạm dừng' : 'Đã hủy' %>
                                </span>
                            </td>
                            <td>
                                <% if (registration.status === 'pending') { %>
                                    <button class="btn-action btn-approve" onclick="approveVehicle('<%= registration._id %>')">
                                        <i class="fas fa-check"></i> Duyệt
                                    </button>
                                    <button class="btn-action btn-reject" onclick="rejectVehicle('<%= registration._id %>')">
                                        <i class="fas fa-times"></i> Từ chối
                                    </button>
                                <% } else { %>
                                    <button class="btn-action btn-view" onclick="viewVehicle('<%= registration._id %>')">
                                        <i class="fas fa-eye"></i> Xem
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                <i class="fas fa-car text-muted" style="font-size: 48px; margin-bottom: 15px;"></i>
                                <br>
                                <span class="text-muted">Chưa có đăng ký xe nào</span>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Approve Modal -->
    <div class="modal fade" id="approveModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Duyệt đăng ký xe</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="approveForm">
                        <input type="hidden" id="approveVehicleId">
                        <div class="form-group">
                            <label for="cardNumber" class="form-label">Số thẻ gửi xe</label>
                            <input type="text" class="form-control" id="cardNumber" name="cardNumber" 
                                   placeholder="Nhập số thẻ hoặc để trống để tự động tạo">
                            <small class="text-muted">Nếu để trống, hệ thống sẽ tự động tạo số thẻ</small>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-success" onclick="confirmApprove()">Duyệt đăng ký</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Reject Modal -->
    <div class="modal fade" id="rejectModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Từ chối đăng ký xe</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="rejectForm">
                        <input type="hidden" id="rejectVehicleId">
                        <div class="form-group">
                            <label for="rejectReason" class="form-label">Lý do từ chối *</label>
                            <textarea class="form-control" id="rejectReason" name="reason" rows="4" 
                                      placeholder="Nhập lý do từ chối đăng ký" required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-danger" onclick="confirmReject()">Từ chối</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function() {
            // Initialize DataTable
            $('#vehicleTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/vi.json'
                },
                responsive: true,
                pageLength: 10,
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "Tất cả"]],
                order: [[5, 'desc']] // Sort by registration date descending
            });
        });

        function approveVehicle(vehicleId) {
            $('#approveVehicleId').val(vehicleId);
            $('#approveModal').modal('show');
        }

        function rejectVehicle(vehicleId) {
            $('#rejectVehicleId').val(vehicleId);
            $('#rejectModal').modal('show');
        }

        function confirmApprove() {
            const vehicleId = $('#approveVehicleId').val();
            const cardNumber = $('#cardNumber').val();

            $.ajax({
                url: `/admin/parking/approve/${vehicleId}`,
                method: 'POST',
                data: { cardNumber: cardNumber },
                success: function(response) {
                    showAlert('success', response.message || 'Duyệt đăng ký xe thành công!');
                    $('#approveModal').modal('hide');
                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                },
                error: function(xhr) {
                    const error = xhr.responseJSON ? xhr.responseJSON.error : 'Có lỗi xảy ra';
                    showAlert('error', error);
                }
            });
        }

        function confirmReject() {
            const vehicleId = $('#rejectVehicleId').val();
            const reason = $('#rejectReason').val().trim();

            if (!reason) {
                showAlert('error', 'Vui lòng nhập lý do từ chối');
                return;
            }

            $.ajax({
                url: `/admin/parking/reject/${vehicleId}`,
                method: 'POST',
                data: { reason: reason },
                success: function(response) {
                    showAlert('success', response.message || 'Từ chối đăng ký xe thành công!');
                    $('#rejectModal').modal('hide');
                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                },
                error: function(xhr) {
                    const error = xhr.responseJSON ? xhr.responseJSON.error : 'Có lỗi xảy ra';
                    showAlert('error', error);
                }
            });
        }

        function viewVehicle(vehicleId) {
            // Implement view functionality
            showAlert('info', 'Chức năng xem chi tiết xe sẽ được phát triển sau');
        }

        function showAlert(type, message) {
            const alertType = type === 'success' ? 'alert-success' : 
                             type === 'error' ? 'alert-danger' : 'alert-info';
            const icon = type === 'success' ? 'fa-check-circle' : 
                        type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle';
            
            const alertHtml = `
                <div class="alert ${alertType} alert-dismissible fade show" role="alert">
                    <i class="fas ${icon} me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            
            $('#alertContainer').html(alertHtml);
            
            // Auto-hide after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut();
            }, 5000);
        }
    </script>
</body>
</html>