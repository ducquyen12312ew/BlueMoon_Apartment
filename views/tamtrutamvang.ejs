<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Tạm trú, Tạm vắng - BlueMoon</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <style>
        :root {
            --primary-color: #2a9d8f;
            --secondary-color: #264653;
            --light-color: #e9c46a;
            --accent-color: #f4a261;
            --dark-color: #e76f51;
            --sidebar-width: 250px;
            --border-radius: 12px;
            --card-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            --transition-speed: 0.3s;
        }
        
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fc;
            color: #333;
        }
        
        /* Sidebar */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: linear-gradient(180deg, var(--secondary-color) 0%, #1d3a47 100%);
            position: fixed;
            left: 0;
            top: 0;
            color: white;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
            z-index: 100;
        }
        
        .sidebar-header {
            padding: 25px;
            font-size: 28px;
            font-weight: bold;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.05);
            letter-spacing: 1px;
        }
        
        .sidebar-menu {
            padding: 25px 0;
            overflow-y: auto;
            max-height: calc(100vh - 180px);
        }
        
        .menu-item {
            padding: 16px 25px;
            cursor: pointer;
            transition: all var(--transition-speed);
            display: flex;
            align-items: center;
            font-size: 17px;
            text-decoration: none;
            color: rgba(255, 255, 255, 0.85);
            border-left: 3px solid transparent;
        }
        
        .menu-item:hover {
            background-color: rgba(42, 157, 143, 0.2);
            color: white;
            transform: translateX(3px);
        }
        
        .menu-item.active {
            background: linear-gradient(90deg, rgba(42, 157, 143, 0.2) 0%, rgba(42, 157, 143, 0) 100%);
            border-left: 3px solid var(--primary-color);
            color: white;
            font-weight: 500;
        }
        
        .menu-item i {
            margin-right: 15px;
            width: 24px;
            text-align: center;
            font-size: 18px;
            opacity: 0.9;
        }
        
        .logout-btn {
            position: absolute;
            bottom: 20px;
            width: 100%;
            padding: 16px 25px;
            cursor: pointer;
            transition: all var(--transition-speed);
            display: flex;
            align-items: center;
            font-size: 17px;
            color: rgba(255, 255, 255, 0.85);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .logout-btn:hover {
            background-color: rgba(231, 111, 81, 0.2);
            color: white;
        }
        
        .logout-btn i {
            margin-right: 15px;
            font-size: 18px;
        }
        
        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 25px;
        }
        
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .page-title {
            font-size: 26px;
            font-weight: 600;
            color: var(--secondary-color);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
        }
        
        .page-title i {
            margin-right: 12px;
            font-size: 28px;
            color: var(--primary-color);
        }
        
        .page-subtitle {
            color: #6c757d;
            font-size: 15px;
            margin-bottom: 0;
        }

        .header-actions {
            display: flex;
            gap: 10px;
        }
        
        /* Tab Navigation */
        .nav-tabs {
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
        }
        
        .nav-tabs .nav-item .nav-link {
            border: none;
            color: #6c757d;
            font-weight: 500;
            padding: 12px 20px;
            border-radius: 0;
            position: relative;
            transition: all 0.3s;
        }
        
        .nav-tabs .nav-item .nav-link.active {
            color: var(--primary-color);
            background-color: transparent;
        }
        
        .nav-tabs .nav-item .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background-color: var(--primary-color);
        }
        
        .nav-tabs .nav-item .nav-link:hover:not(.active) {
            color: var(--dark-color);
            border-color: transparent;
        }
        
        /* Content Cards */
        .content-card {
            background-color: white;
            border-radius: var(--border-radius);
            box-shadow: var(--card-shadow);
            overflow: hidden;
            margin-bottom: 20px;
        }
        
        .content-card-header {
            padding: 18px 20px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .content-card-title {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
            color: var(--secondary-color);
            display: flex;
            align-items: center;
        }
        
        .content-card-title i {
            margin-right: 10px;
            font-size: 16px;
            color: var(--primary-color);
        }
        
        .content-card-body {
            padding: 20px;
        }
        
        /* Tables */
        .custom-table {
            width: 100%;
            border-collapse: collapse;
        }
        
        .custom-table th {
            background-color: rgba(42, 157, 143, 0.05);
            color: var(--secondary-color);
            font-weight: 600;
            padding: 12px 15px;
            text-align: left;
            border-bottom: 2px solid rgba(0, 0, 0, 0.05);
        }
        
        .custom-table td {
            padding: 12px 15px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .custom-table tr:last-child td {
            border-bottom: none;
        }
        
        .custom-table tr:hover {
            background-color: rgba(42, 157, 143, 0.03);
        }
        
        /* Status Badge */
        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }
        
        .status-pending {
            background-color: rgba(233, 196, 106, 0.1);
            color: var(--light-color);
        }
        
        .status-approved {
            background-color: rgba(42, 157, 143, 0.1);
            color: var(--primary-color);
        }
        
        .status-rejected {
            background-color: rgba(231, 111, 81, 0.1);
            color: var(--dark-color);
        }
        
        /* Action Buttons */
        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 4px;
            background-color: rgba(38, 70, 83, 0.1);
            color: var(--secondary-color);
            border: none;
            margin-right: 5px;
            transition: all 0.2s;
        }
        
        .action-btn:hover {
            background-color: var(--primary-color);
            color: white;
        }
        
        .btn-action {
            display: inline-flex;
            align-items: center;
            padding: 8px 16px;
            border-radius: 6px;
            background-color: var(--primary-color);
            color: white;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.2s;
        }
        
        .btn-action:hover {
            background-color: #248a7c;
            color: white;
            transform: translateY(-2px);
        }
        
        .btn-action i {
            margin-right: 8px;
        }
        
        /* Search Box */
        .search-container {
            position: relative;
            margin-bottom: 20px;
        }
        
        .search-box {
            width: 100%;
            padding: 10px 15px 10px 40px;
            border: 1px solid rgba(0, 0, 0, 0.1);
            border-radius: 6px;
            font-size: 14px;
        }
        
        .search-box:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(42, 157, 143, 0.25);
        }
        
        .search-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
        }
        
        /* Empty State */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
            text-align: center;
        }
        
        .empty-state i {
            font-size: 48px;
            color: rgba(42, 157, 143, 0.2);
            margin-bottom: 15px;
        }
        
        .empty-state-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 10px;
            color: #333;
        }
        
        .empty-state-text {
            color: #6c757d;
            max-width: 500px;
            margin-bottom: 20px;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .sidebar {
                width: 200px;
            }
            
            .main-content {
                margin-left: 200px;
            }
            
            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .header-actions {
                margin-top: 15px;
            }
        }
        
        @media (max-width: 576px) {
            .sidebar {
                width: 70px;
            }
            
            .sidebar-header {
                font-size: 18px;
                padding: 15px 0;
            }
            
            .menu-item span,
            .logout-btn span {
                display: none;
            }
            
            .menu-item i,
            .logout-btn i {
                margin-right: 0;
            }
            
            .main-content {
                margin-left: 70px;
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            BLUEMOON
        </div>
        <div class="sidebar-menu">
            <a href="/toquan/dashboard" class="menu-item">
                <i class="fas fa-tachometer-alt"></i>
                <span>Trang chủ</span>
            </a>
            <a href="/toquan/hokhau-nhankhau" class="menu-item">
                <i class="fas fa-house-user"></i>
                <span>Quản lý hộ khẩu</span>
            </a>
            <a href="/toquan/tamtrutamvang" class="menu-item active">
                <i class="fas fa-exchange-alt"></i>
                <span>Tạm trú tạm vắng</span>
            </a>
            <a href="/toquan/thongke" class="menu-item">
                <i class="fas fa-chart-bar"></i>
                <span>Thống kê</span>
            </a>
            <a href="/toquan/maintenance" class="menu-item">
                <i class="fas fa-tools"></i>
                <span>Phân công bảo trì</span>
            </a>
            <a href="/toquan/maintenance" class="menu-item">
                <i class="fas fa-file-alt"></i>
                <span>Phản ánh của cư dân</span>
            </a>
        </div>
        </div>
        <div class="logout-btn">
            <a href="/logout" style="color: inherit; text-decoration: none; display: flex; align-items: center; width: 100%;">
                <i class="fas fa-sign-out-alt"></i>
                <span>ĐĂNG XUẤT</span>
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="page-header">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-exchange-alt"></i>
                    Quản lý Tạm trú, Tạm vắng
                </h1>
                <p class="page-subtitle">Quản lý thông tin tạm trú, tạm vắng cho cư dân trong chung cư</p>
            </div>
            <div class="header-actions">
                <a href="/toquan/tamtru/add" class="btn-action">
                    <i class="fas fa-plus"></i> Đăng ký tạm trú
                </a>
                <a href="/toquan/tamvang/add" class="btn-action" style="background-color: var(--secondary-color);">
                    <i class="fas fa-plus"></i> Đăng ký tạm vắng
                </a>
            </div>
        </div>
        
        <!-- Tab Navigation -->
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tamtru-tab" data-bs-toggle="tab" data-bs-target="#tamtru" type="button" role="tab" aria-controls="tamtru" aria-selected="true">Tạm trú</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tamvang-tab" data-bs-toggle="tab" data-bs-target="#tamvang" type="button" role="tab" aria-controls="tamvang" aria-selected="false">Tạm vắng</button>
            </li>
        </ul>
        
        <div class="tab-content" id="myTabContent">
            <!-- Tạm trú Tab -->
            <div class="tab-pane fade show active" id="tamtru" role="tabpanel" aria-labelledby="tamtru-tab">
                <!-- Search Box -->
                <div class="search-container">
                    <input type="text" class="search-box" id="tamtru-search" placeholder="Tìm kiếm tạm trú...">
                    <i class="fas fa-search search-icon"></i>
                </div>
                
                <!-- Tạm trú Table -->
                <div class="content-card">
                    <div class="content-card-body">
                        <div class="table-responsive">
                            <table class="custom-table" id="tamtru-table">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Người đăng ký</th>
                                        <th>Địa chỉ tạm trú</th>
                                        <th>Thời gian</th>
                                        <th>Lý do</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (tamTruList && tamTruList.length > 0) { %>
                                        <% tamTruList.forEach((tamTru, index) => { %>
                                            <tr>
                                                <td><%= index + 1 %></td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="me-2 text-center" style="width: 32px; height: 32px; background-color: rgba(42, 157, 143, 0.1); color: var(--primary-color); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                                            <i class="fas fa-user"></i>
                                                        </div>
                                                        <%= tamTru.nhanKhau ? tamTru.nhanKhau.hoTen : 'N/A' %>
                                                    </div>
                                                </td>
                                                <td><%= tamTru.diaChiTamTru %></td>
                                                <td>
                                                    <%= new Date(tamTru.tuNgay).toLocaleDateString('vi-VN') %> - 
                                                    <%= new Date(tamTru.denNgay).toLocaleDateString('vi-VN') %>
                                                </td>
                                                <td><%= tamTru.lyDo || 'Không có' %></td>
                                                <td>
                                                    <% if (tamTru.trangThai === 'Chờ duyệt') { %>
                                                        <span class="status-badge status-pending">Chờ duyệt</span>
                                                    <% } else if (tamTru.trangThai === 'Đã duyệt') { %>
                                                        <span class="status-badge status-approved">Đã duyệt</span>
                                                    <% } else { %>
                                                        <span class="status-badge status-rejected">Từ chối</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <a href="/toquan/tamtru/<%= tamTru._id %>" class="action-btn" title="Xem chi tiết">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="/toquan/tamtru/<%= tamTru._id %>/edit" class="action-btn" title="Chỉnh sửa">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button class="action-btn" title="Xóa" onclick="confirmDelete('tamtru', '<%= tamTru._id %>')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7">
                                                <div class="empty-state">
                                                    <i class="fas fa-house-user"></i>
                                                    <h3 class="empty-state-title">Không có dữ liệu tạm trú</h3>
                                                    <p class="empty-state-text">Chưa có thông tin tạm trú nào được đăng ký. Vui lòng thêm mới bằng cách nhấn vào nút "Đăng ký tạm trú".</p>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Tạm vắng Tab -->
            <div class="tab-pane fade" id="tamvang" role="tabpanel" aria-labelledby="tamvang-tab">
                <!-- Search Box -->
                <div class="search-container">
                    <input type="text" class="search-box" id="tamvang-search" placeholder="Tìm kiếm tạm vắng...">
                    <i class="fas fa-search search-icon"></i>
                </div>
                
                <!-- Tạm vắng Table -->
                <div class="content-card">
                    <div class="content-card-body">
                        <div class="table-responsive">
                            <table class="custom-table" id="tamvang-table">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Người đăng ký</th>
                                        <th>Nơi tạm trú</th>
                                        <th>Thời gian</th>
                                        <th>Lý do</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (tamVangList && tamVangList.length > 0) { %>
                                        <% tamVangList.forEach((tamVang, index) => { %>
                                            <tr>
                                                <td><%= index + 1 %></td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="me-2 text-center" style="width: 32px; height: 32px; background-color: rgba(38, 70, 83, 0.1); color: var(--secondary-color); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                                            <i class="fas fa-user"></i>
                                                        </div>
                                                        <%= tamVang.nhanKhau ? tamVang.nhanKhau.hoTen : 'N/A' %>
                                                    </div>
                                                </td>
                                                <td><%= tamVang.noiTamTru %></td>
                                                <td>
                                                    <%= new Date(tamVang.tuNgay).toLocaleDateString('vi-VN') %> - 
                                                    <%= new Date(tamVang.denNgay).toLocaleDateString('vi-VN') %>
                                                </td>
                                                <td><%= tamVang.lyDo || 'Không có' %></td>
                                                <td>
                                                    <% if (tamVang.trangThai === 'Chờ duyệt') { %>
                                                        <span class="status-badge status-pending">Chờ duyệt</span>
                                                    <% } else if (tamVang.trangThai === 'Đã duyệt') { %>
                                                        <span class="status-badge status-approved">Đã duyệt</span>
                                                    <% } else { %>
                                                        <span class="status-badge status-rejected">Từ chối</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <a href="/toquan/tamvang/<%= tamVang._id %>" class="action-btn" title="Xem chi tiết">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="/toquan/tamvang/<%= tamVang._id %>/edit" class="action-btn" title="Chỉnh sửa">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button class="action-btn" title="Xóa" onclick="confirmDelete('tamvang', '<%= tamVang._id %>')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7">
                                                <div class="empty-state">
                                                    <i class="fas fa-house-user"></i>
                                                    <h3 class="empty-state-title">Không có dữ liệu tạm vắng</h3>
                                                    <p class="empty-state-text">Chưa có thông tin tạm vắng nào được đăng ký. Vui lòng thêm mới bằng cách nhấn vào nút "Đăng ký tạm vắng".</p>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Hàm xác nhận xóa
        function confirmDelete(type, id) {
            if (confirm(`Bạn có chắc chắn muốn xóa thông tin này?`)) {
                window.location.href = `/toquan/${type}/${id}/delete`;
            }
        }
        
        // Tìm kiếm tạm trú
        document.getElementById('tamtru-search').addEventListener('keyup', function() {
            const searchText = this.value.toLowerCase();
            const table = document.getElementById('tamtru-table');
            const rows = table.getElementsByTagName('tr');
            
            for (let i = 1; i < rows.length; i++) {
                const row = rows[i];
                // Bỏ qua hàng empty state
                if (row.getElementsByTagName('td').length === 1) continue;
                
                let found = false;
                const cells = row.getElementsByTagName('td');
                
                for (let j = 1; j < cells.length - 1; j++) {
                    const cellText = cells[j].textContent.toLowerCase();
                    if (cellText.includes(searchText)) {
                        found = true;
                        break;
                    }
                }
                
                row.style.display = found ? '' : 'none';
            }
        });
        
        // Tìm kiếm tạm vắng
        document.getElementById('tamvang-search').addEventListener('keyup', function() {
            const searchText = this.value.toLowerCase();
            const table = document.getElementById('tamvang-table');
            const rows = table.getElementsByTagName('tr');
            
            for (let i = 1; i < rows.length; i++) {
                const row = rows[i];
                // Bỏ qua hàng empty state
                if (row.getElementsByTagName('td').length === 1) continue;
                
                let found = false;
                const cells = row.getElementsByTagName('td');
                
                for (let j = 1; j < cells.length - 1; j++) {
                    const cellText = cells[j].textContent.toLowerCase();
                    if (cellText.includes(searchText)) {
                        found = true;
                        break;
                    }
                }
                
                row.style.display = found ? '' : 'none';
            }
        });
    </script>
</body>
</html>