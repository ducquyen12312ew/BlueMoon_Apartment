<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thống kê Dân cư - BlueMoon</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --primary-color: #2a9d8f;
            --secondary-color: #264653;
            --light-color: #e9c46a;
            --accent-color: #f4a261;
            --dark-color: #e76f51;
            --sidebar-width: 250px;
            --border-radius: 12px;
            --card-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            --transition-speed: 0.3s;
        }
        
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fc;
            color: #333;
        }
        
        /* Sidebar */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: linear-gradient(180deg, var(--secondary-color) 0%, #1d3a47 100%);
            position: fixed;
            left: 0;
            top: 0;
            color: white;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
            z-index: 100;
        }
        
        .sidebar-header {
            padding: 25px;
            font-size: 28px;
            font-weight: bold;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.05);
            letter-spacing: 1px;
        }
        
        .sidebar-menu {
            padding: 25px 0;
            overflow-y: auto;
            max-height: calc(100vh - 180px);
        }
        
        .menu-item {
            padding: 16px 25px;
            cursor: pointer;
            transition: all var(--transition-speed);
            display: flex;
            align-items: center;
            font-size: 17px;
            text-decoration: none;
            color: rgba(255, 255, 255, 0.85);
            border-left: 3px solid transparent;
        }
        
        .menu-item:hover {
            background-color: rgba(42, 157, 143, 0.2);
            color: white;
            transform: translateX(3px);
        }
        
        .menu-item.active {
            background: linear-gradient(90deg, rgba(42, 157, 143, 0.2) 0%, rgba(42, 157, 143, 0) 100%);
            border-left: 3px solid var(--primary-color);
            color: white;
            font-weight: 500;
        }
        
        .menu-item i {
            margin-right: 15px;
            width: 24px;
            text-align: center;
            font-size: 18px;
            opacity: 0.9;
        }
        
        .logout-btn {
            position: absolute;
            bottom: 20px;
            width: 100%;
            padding: 16px 25px;
            cursor: pointer;
            transition: all var(--transition-speed);
            display: flex;
            align-items: center;
            font-size: 17px;
            color: rgba(255, 255, 255, 0.85);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .logout-btn:hover {
            background-color: rgba(231, 111, 81, 0.2);
            color: white;
        }
        
        .logout-btn i {
            margin-right: 15px;
            font-size: 18px;
        }
        
        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 25px;
        }
        
        .page-header {
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .page-title {
            font-size: 26px;
            font-weight: 600;
            color: var(--secondary-color);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
        }
        
        .page-title i {
            margin-right: 12px;
            font-size: 28px;
            color: var(--primary-color);
        }
        
        .page-subtitle {
            color: #6c757d;
            font-size: 15px;
            margin-bottom: 0;
        }
        
        /* Stats Cards */
        .stats-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .stat-card {
            flex: 1;
            min-width: 200px;
            background-color: white;
            border-radius: var(--border-radius);
            box-shadow: var(--card-shadow);
            padding: 20px;
            position: relative;
            overflow: hidden;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: transform 0.3s;
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
        }
        
        .stat-card::after {
            content: '';
            position: absolute;
            width: 5px;
            height: 100%;
            top: 0;
            left: 0;
        }
        
        .stat-card-primary::after {
            background-color: var(--primary-color);
        }
        
        .stat-card-secondary::after {
            background-color: var(--secondary-color);
        }
        
        .stat-card-light::after {
            background-color: var(--light-color);
        }
        
        .stat-card-accent::after {
            background-color: var(--accent-color);
        }
        
        .stat-info {
            z-index: 1;
        }
        
        .stat-info h2 {
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 5px;
            color: #333;
        }
        
        .stat-info p {
            margin: 0;
            color: #6c757d;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .stat-icon {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-size: 24px;
            z-index: 1;
        }
        
        .stat-card-primary .stat-icon {
            background-color: rgba(42, 157, 143, 0.1);
            color: var(--primary-color);
        }
        
        .stat-card-secondary .stat-icon {
            background-color: rgba(38, 70, 83, 0.1);
            color: var(--secondary-color);
        }
        
        .stat-card-light .stat-icon {
            background-color: rgba(233, 196, 106, 0.1);
            color: var(--light-color);
        }
        
        .stat-card-accent .stat-icon {
            background-color: rgba(244, 162, 97, 0.1);
            color: var(--accent-color);
        }
        
        /* Chart Cards */
        .chart-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .chart-card {
            flex: 1;
            min-width: 300px;
            background-color: white;
            border-radius: var(--border-radius);
            box-shadow: var(--card-shadow);
            overflow: hidden;
        }
        
        .chart-card-header {
            padding: 20px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .chart-card-title {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
            color: var(--secondary-color);
            display: flex;
            align-items: center;
        }
        
        .chart-card-title i {
            margin-right: 10px;
            color: var(--primary-color);
        }
        
        .chart-card-body {
            padding: 20px;
            height: 300px;
        }
        
        /* Data Tables */
        .table-card {
            background-color: white;
            border-radius: var(--border-radius);
            box-shadow: var(--card-shadow);
            overflow: hidden;
            margin-bottom: 30px;
        }
        
        .table-card-header {
            padding: 20px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .table-card-title {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
            color: var(--secondary-color);
            display: flex;
            align-items: center;
        }
        
        .table-card-title i {
            margin-right: 10px;
            color: var(--primary-color);
        }
        
        .table-card-body {
            padding: 20px;
        }
        
        .custom-table {
            width: 100%;
            border-collapse: collapse;
        }
        
        .custom-table th {
            background-color: rgba(42, 157, 143, 0.05);
            color: var(--secondary-color);
            font-weight: 600;
            padding: 12px 15px;
            text-align: left;
            border-bottom: 2px solid rgba(0, 0, 0, 0.05);
        }
        
        .custom-table td {
            padding: 12px 15px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .custom-table tr:last-child td {
            border-bottom: none;
        }
        
        .custom-table tr:hover {
            background-color: rgba(42, 157, 143, 0.03);
        }
        
        /* Report Export Button */
        .btn-export {
            display: inline-flex;
            align-items: center;
            padding: 8px 16px;
            background-color: var(--secondary-color);
            color: white;
            border: none;
            border-radius: 6px;
            font-weight: 500;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .btn-export:hover {
            background-color: #1d3a47;
            transform: translateY(-2px);
        }
        
        .btn-export i {
            margin-right: 8px;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .sidebar {
                width: 200px;
            }
            
            .main-content {
                margin-left: 200px;
            }
            
            .stats-row, .chart-row {
                flex-direction: column;
            }
            
            .stat-card, .chart-card {
                width: 100%;
            }
        }
        
        @media (max-width: 576px) {
            .sidebar {
                width: 70px;
            }
            
            .sidebar-header {
                font-size: 18px;
                padding: 15px 0;
            }
            
            .menu-item span,
            .logout-btn span {
                display: none;
            }
            
            .menu-item i,
            .logout-btn i {
                margin-right: 0;
            }
            
            .main-content {
                margin-left: 70px;
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            BLUEMOON
        </div>
        <div class="sidebar-menu">
            <a href="/topho/dashboard" class="menu-item">
                <i class="fas fa-tachometer-alt"></i>
                <span>Trang chủ</span>
            </a>
          
            <a href="/topho/thongke" class="menu-item active">
                <i class="fas fa-chart-bar"></i>
                <span>Thống kê</span>
            </a>
            
        </div>
        <div class="logout-btn">
            <a href="/logout" style="color: inherit; text-decoration: none; display: flex; align-items: center; width: 100%;">
                <i class="fas fa-sign-out-alt"></i>
                <span>ĐĂNG XUẤT</span>
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="page-title">
                        <i class="fas fa-chart-bar"></i>
                        Thống kê Dân cư
                    </h1>
                    <p class="page-subtitle">Số liệu thống kê về dân cư trong chung cư BlueMoon</p>
                </div>
                <button class="btn-export" onclick="exportReport()">
                    <i class="fas fa-file-export"></i>
                    Xuất báo cáo
                </button>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="stats-row">
            <div class="stat-card stat-card-primary">
                <div class="stat-info">
                    <h2><%= totalHoKhau %></h2>
                    <p>Tổng số hộ khẩu</p>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-home"></i>
                </div>
            </div>
            <div class="stat-card stat-card-secondary">
                <div class="stat-info">
                    <h2><%= totalNhanKhau %></h2>
                    <p>Tổng số nhân khẩu</p>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-users"></i>
                </div>
            </div>
            <div class="stat-card stat-card-light">
                <div class="stat-info">
                    <h2><%= totalTamTru %></h2>
                    <p>Đang tạm trú</p>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-sign-in-alt"></i>
                </div>
            </div>
            <div class="stat-card stat-card-accent">
                <div class="stat-info">
                    <h2><%= totalTamVang %></h2>
                    <p>Đang tạm vắng</p>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-sign-out-alt"></i>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="chart-row">
            <!-- Gender Distribution Chart -->
            <div class="chart-card">
                <div class="chart-card-header">
                    <h2 class="chart-card-title">
                        <i class="fas fa-venus-mars"></i>
                        Phân bố giới tính
                    </h2>
                </div>
                <div class="chart-card-body">
                    <canvas id="genderChart"></canvas>
                </div>
            </div>

            <!-- Age Group Distribution Chart -->
            <div class="chart-card">
                <div class="chart-card-header">
                    <h2 class="chart-card-title">
                        <i class="fas fa-user-clock"></i>
                        Phân bố độ tuổi
                    </h2>
                </div>
                <div class="chart-card-body">
                    <canvas id="ageChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Population Changes Chart -->
        <div class="chart-card mb-4">
            <div class="chart-card-header">
                <h2 class="chart-card-title">
                    <i class="fas fa-chart-line"></i>
                    Biến động dân số theo tháng
                </h2>
            </div>
            <div class="chart-card-body">
                <canvas id="populationChangesChart"></canvas>
            </div>
        </div>

        <!-- Detailed Stats Table -->
        <div class="table-card">
            <div class="table-card-header">
                <h2 class="table-card-title">
                    <i class="fas fa-table"></i>
                    Thống kê chi tiết
                </h2>
            </div>
            <div class="table-card-body">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Phân loại</th>
                            <th>Số lượng</th>
                            <th>Phần trăm</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Nam</td>
                            <td><%= maleCount %></td>
                            <td><%= (maleCount / totalNhanKhau * 100).toFixed(1) %>%</td>
                        </tr>
                        <tr>
                            <td>Nữ</td>
                            <td><%= femaleCount %></td>
                            <td><%= (femaleCount / totalNhanKhau * 100).toFixed(1) %>%</td>
                        </tr>
                        <tr>
                            <td>Trẻ em (dưới 18 tuổi)</td>
                            <td><%= under18Count %></td>
                            <td><%= (under18Count / totalNhanKhau * 100).toFixed(1) %>%</td>
                        </tr>
                        <tr>
                            <td>Người trưởng thành (18-60 tuổi)</td>
                            <td><%= adult18to60Count %></td>
                            <td><%= (adult18to60Count / totalNhanKhau * 100).toFixed(1) %>%</td>
                        </tr>
                        <tr>
                            <td>Người cao tuổi (trên 60 tuổi)</td>
                            <td><%= over60Count %></td>
                            <td><%= (over60Count / totalNhanKhau * 100).toFixed(1) %>%</td>
                        </tr>
                        <tr>
                            <td>Đang tạm trú</td>
                            <td><%= totalTamTru %></td>
                            <td><%= (totalTamTru / (totalNhanKhau + totalTamTru) * 100).toFixed(1) %>%</td>
                        </tr>
                        <tr>
                            <td>Đang tạm vắng</td>
                            <td><%= totalTamVang %></td>
                            <td><%= (totalTamVang / totalNhanKhau * 100).toFixed(1) %>%</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Gender Distribution Chart
            const genderChart = document.getElementById('genderChart').getContext('2d');
            new Chart(genderChart, {
                type: 'doughnut',
                data: {
                    labels: ['Nam', 'Nữ'],
                    datasets: [{
                        data: [<%= maleCount %>, <%= femaleCount %>],
                        backgroundColor: [
                            '#264653',
                            '#2a9d8f'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        title: {
                            display: true,
                            text: 'Phân bố theo giới tính'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const value = context.raw;
                                    const total = context.dataset.data.reduce((acc, val) => acc + val, 0);
                                    const percentage = Math.round((value / total) * 100);
                                    return `${context.label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    },
                    cutout: '60%'
                }
            });
            
            // Age Distribution Chart
            const ageChart = document.getElementById('ageChart').getContext('2d');
            new Chart(ageChart, {
                type: 'bar',
                data: {
                    labels: ['Dưới 18 tuổi', '18-60 tuổi', 'Trên 60 tuổi'],
                    datasets: [{
                        label: 'Số lượng',
                        data: [<%= under18Count %>, <%= adult18to60Count %>, <%= over60Count %>],
                        backgroundColor: [
                            '#e9c46a',
                            '#f4a261',
                            '#e76f51'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        title: {
                            display: true,
                            text: 'Phân bố theo độ tuổi'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const value = context.raw;
                                    const total = <%= totalNhanKhau %>;
                                    const percentage = Math.round((value / total) * 100);
                                    return `${context.dataset.label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });
            
            // Population Changes Chart
            const populationChangesChart = document.getElementById('populationChangesChart').getContext('2d');
            new Chart(populationChangesChart, {
                type: 'line',
                data: {
                    labels: [<% monthLabels.forEach(function(month, index) { %>'<%= month %>'<%= index < monthLabels.length - 1 ? ',' : '' %><% }); %>],
                    datasets: [{
                        label: 'Biến động dân số',
                        data: [<% populationChanges.forEach(function(count, index) { %><%= count %><%= index < populationChanges.length - 1 ? ',' : '' %><% }); %>],
                        borderColor: '#2a9d8f',
                        backgroundColor: 'rgba(42, 157, 143, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2,
                        pointBackgroundColor: '#2a9d8f',
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    },
                    plugins: {
                        title: {
                            display: true,
                            text: 'Biến động dân số 6 tháng gần đây'
                        }
                    }
                }
            });
        });
        
        // Export Report Function
        function exportReport() {
            alert('Chức năng xuất báo cáo đang được phát triển');
            
            // Code để xuất báo cáo có thể thêm vào đây
            // Có thể sử dụng thư viện như jsPDF, html2canvas, hoặc gửi request về server để tạo file PDF
        }
    </script>
</body>
</html>