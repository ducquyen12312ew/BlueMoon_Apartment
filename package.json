{
  "name": "bluemoon-apartment-management",
  "version": "1.0.0",
  "description": "Apartment Management System for Blue Moon",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:auth": "jest tests/routes/auth.test.js",
    "test:khoan-thu": "jest tests/routes/khoan-thu.test.js",
    "test:nop-phi": "jest tests/routes/nop-phi.test.js",
    "test:feedback": "jest tests/routes/feedback.test.js",
    "test:ho-khau": "jest tests/routes/ho-khau.test.js",
    "test:profile": "jest tests/routes/profile.test.js",
    "test:stats": "jest tests/routes/stats.test.js",
    "test:utils": "jest tests/utils/test-utils.test.js",
    "test:setup": "node tests/setup-test-db.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/config.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testTimeout": 30000,
    "verbose": true
  },
  "keywords": [
    "apartment",
    "management",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Blue Moon Development Team",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.13.0",
    "puppeteer": "^21.0.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.1",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
